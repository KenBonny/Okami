---
import "../styles/global.css"
import { Image } from 'astro:assets';
import okamiImage from "../assets/okami.png";

const today = new Date();
---

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" href="/okami.ico"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="generator" content={Astro.generator}/>
    <title>Okami</title>
</head>
<body class="min-h-screen flex flex-col bg-white">
<main class="flex-1 pb-16">
    <section class="flex flex-col items-center gap-4 py-8 px-4 sm:px-8 lg:flex-row lg:justify-center lg:gap-12 lg:py-12 max-w-screen-2xl mx-auto">
        <Image src={okamiImage}
               priority
               height="200"
               width="200"
               class="h-32 w-32 lg:h-[200px] lg:w-[200px] object-contain shrink-0"
               alt="A cute stylized orange and yellow dragon representing Okami"/>
        <div class="flex flex-col items-center gap-3 text-center lg:items-start lg:text-left">
            <a href="/"><h1>Okami</h1></a>
            <a href="/about" class="text-xl font-normal leading-7">The dragon that guards your freezer!</a>
        </div>
    </section>
    <slot/>
</main>
<footer class="fixed bottom-0 left-0 right-0 z-10 h-16 w-full bg-white border-t border-gray-900/10 mt-auto dark:border-white/10">
    <div class="my-4 px-4 mx-auto max-w-screen-2xl">
        <p class="text-sm/6 text-gray-600 dark:text-gray-400">
            &copy; {today.getFullYear()} More Than Code BV.
            Check out the <a href="/about">Privacy Policy</a> here.
        </p>
    </div>
</footer>
</body>
</html>
